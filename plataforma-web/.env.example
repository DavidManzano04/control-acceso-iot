# Copia este archivo como .env y llena tus datos. El .env NO se sube a GitHub.

# Broker MQTT (HiveMQ Cloud)
ACCESO_MQTT_BROKER=tu-cluster.s1.eu.hivemq.cloud
ACCESO_MQTT_PORT=8883
ACCESO_MQTT_USER=tu_usuario
ACCESO_MQTT_PASSWORD=tu_contraseña

# Secreto HMAC de cada lector (debe coincidir con el config.json del ESP32)
ACCESO_SECRET_ENTRADA=
ACCESO_SECRET_SALIDA=

# Clave para firmar los JWT (opcional; si no se define se genera jwt_secret.key)
ACCESO_JWT_SECRET=

# Contraseña inicial del usuario admin (solo se usa la primera vez)
ACCESO_CLAVE_INICIAL=admin123
